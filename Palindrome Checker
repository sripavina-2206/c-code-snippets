#include <stdio.h>
#include <string.h>

int main() {
    char word[30];
    int i, len, is_palindrome = 1;

    printf("Enter a word: ");
    scanf("%29s", word);
    len = strlen(word);

    for (i = 0; i < len / 2; i++) {
        if (word[i] != word[len - 1 - i]) {
            is_palindrome = 0;
            break;
        }
    }

    if (is_palindrome) printf("%s is a palindrome.\n", word);
    else printf("%s is not a palindrome.\n", word);
    
    return 0;
}
