#include <stdio.h>

int main() {
    float income, rent, food, transport, total_expenses, savings;

    printf("=== Minimalist Budget Planner ===\n");
    printf("Enter total monthly income: $");
    scanf("%f", &income);

    printf("Enter monthly housing/rent cost: $");
    scanf("%f", &rent);

    printf("Enter monthly food expense estimation: $");
    scanf("%f", &food);

    printf("Enter monthly transport/fuel cost: $");
    scanf("%f", &transport);

    // Summary calculations
    total_expenses = rent + food + transport;
    savings = income - total_expenses;

    printf("\n--- Monthly Overview ---\n");
    printf("Total Money Spent: $%.2f\n", total_expenses);
    printf("Remaining Balance/Savings: $%.2f\n", savings);

    if (savings < 0) {
        printf("Warning: You are spending more than you earn by $%.2f!\n", -savings);
    } else {
        float savings_rate = (savings / income) * 100;
        printf("Awesome! You saved %.1f%% of your total income.\n", savings_rate);
    }

    return 0;
}
