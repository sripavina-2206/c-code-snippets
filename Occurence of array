#include<stdio.h>
   int main()
   {
   int arr[20];
   int size,i,j,tosearch,count=0;
   printf("Enter the size of the array:");
   scanf("%d",&size);
   printf("Enter the elements:");
   for(i=0;i<size;i++)
  {
    scanf("%d",&arr[i]);
  }
  printf("Enter an element to search:");
  scanf("%d",&tosearch);
  for(j=0;j<size;j++)
  {
     if(arr[j]==tosearch)
     count=count+1;
  }
  if(count==0)
     printf("The element is not found:");
  else
     printf("The %d occured %d times",tosearch,count);
  return 0;
