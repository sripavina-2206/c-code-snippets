#include <stdio.h>

int main() {
    int secret_number = 42; // The magic target number
    int guess;
    int attempts = 0;

    printf("=== Guess the Hidden Number ===\n");
    printf("I am thinking of a number between 1 and 100.\n\n");

    while(1) {
        printf("Enter your guess: ");
        scanf("%d", &guess);
        attempts++;

        if(guess == secret_number) {
            printf("Congratulations! You found it in %d attempts.\n", attempts);
            break;
        } else if(guess < secret_number) {
            printf("Too low! Try again.\n\n");
        } else {
            printf("Too high! Try again.\n\n");
        }
    }

    return 0;
}
