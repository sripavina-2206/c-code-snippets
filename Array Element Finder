#include <stdio.h>

int main() {
    int arr[] = {12, 45, 78, 23, 56, 89, 34};
    int n = sizeof(arr) / sizeof(arr[0]);
    int target, found_at = -1;

    printf("Enter a number to find: ");
    scanf("%d", &target);

    for (int i = 0; i < n; i++) {
        if (arr[i] == target) {
            found_at = i;
            break;
        }
    }

    if (found_at != -1) printf("Element found at index: %d\n", found_at);
    else printf("Element not found in the array.\n");

    return 0;
}
