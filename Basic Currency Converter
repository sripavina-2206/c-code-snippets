#include <stdio.h>

int main() {
    float usd, rate, converted;
    int choice;

    printf("=== Currency Converter ===\n");
    printf("1. Convert USD to EUR (Euros)\n");
    printf("2. Convert USD to INR (Indian Rupees)\n");
    printf("Enter choice (1 or 2): ");
    scanf("%d", &choice);

    printf("Enter amount in USD: $");
    scanf("%f", &usd);

    if (choice == 1) {
        rate = 0.92; // 1 USD = 0.92 EUR (example rate)
        converted = usd * rate;
        printf("$%.2f USD is equal to %.2f EUR\n", usd, converted);
    } else if (choice == 2) {
        rate = 83.50; // 1 USD = 83.50 INR (example rate)
        converted = usd * rate;
        printf("$%.2f USD is equal to %.2f INR\n", usd, converted);
    } else {
        printf("Invalid selection!\n");
    }

    return 0;
}
