#include<stdio.h>
   int main()
   {
   int row,col;
   int i,j;
   int mat[10][10],trans[10][10];
   printf("Enter number of rows:");
   scanf("%d",&row);
   printf("Enter number of column:");
  scanf("%d",&col);
  printf("Enter matrix:");
  for(i=0;i<row;i++)
  {
  for(j=0;j<col;j++)
  {
        scanf("%d",&mat[i][j]);
  }
  }
  for(i=0;i<row;i++)
  {
  for(j=0;j<col;j++)
  {
        trans[i][j]=mat[j][i];
  }
  }
  printf("Transpose of a matrix:\n");
  for(i=0;i<row;i++)
  {
  for(j=0;j<col;j++)
  {
         printf("%d\t",trans[i][j]);
  }
         printf("\n");
  }
